{
  "name": "space-drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fly between local repositories as planets, then land to explore folders as molecules and files as atoms.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "assets:export": "node scripts/export-assets.mjs",
    "assets:capture": "node scripts/capture-assets.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
